# scilex-lpwc-ap -- iteration 2 -- SHACL, GENERAL level (valid for any SciLEx collection).
# Identifiers (OCDM id), with the value syntax of DOI and ISSN.
# One targeted node shape per file, constraints on the focus node's own triples only
# (see ../README.md: how X-DigCheck evaluates shapes).

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix fabio:    <http://purl.org/spar/fabio/> .
@prefix frbr:     <http://purl.org/vocab/frbr/core#> .
@prefix cito:     <http://purl.org/spar/cito/> .
@prefix c4o:      <http://purl.org/spar/c4o/> .
@prefix pro:      <http://purl.org/spar/pro/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix literal:  <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix prism:    <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix oco:      <https://w3id.org/oc/ontology/> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix lpwc:     <https://linkedpaperswithcode.com/class/> .
@prefix lpwcp:    <https://linkedpaperswithcode.com/property/> .
@prefix sxv:      <https://w3id.org/scilex/vocab#> .
@prefix sxsh:     <https://w3id.org/scilex/ap/lpwc/shapes#> .
@prefix ucd:      <https://w3id.org/scilex/ap/lpwc/shapes/ucd#> .

sxsh:IdentifierShape
    a sh:NodeShape ;
    rdfs:label "Identifier (OCDM id)"@en ;
    sh:targetClass datacite:Identifier ;
    sh:property [
        sh:path datacite:usesIdentifierScheme ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( datacite:doi datacite:arxiv datacite:isbn datacite:issn datacite:orcid datacite:url ) ] ;
    sh:property [
        sh:path literal:hasLiteralValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:or (
        [ sh:not [ sh:property [ sh:path datacite:usesIdentifierScheme ; sh:hasValue datacite:doi ] ] ]
        [ sh:property [ sh:path literal:hasLiteralValue ; sh:pattern "^10\\.[0-9]{4,9}/\\S+$" ] ]
    ) ;
    sh:or (
        [ sh:not [ sh:property [ sh:path datacite:usesIdentifierScheme ; sh:hasValue datacite:issn ] ] ]
        [ sh:property [ sh:path literal:hasLiteralValue ; sh:pattern "^[0-9]{4}-[0-9]{3}[0-9X]$" ] ]
    ) ;
    sh:message "DOI values are lower-case, prefix-free DOIs (10.NNNN/...); ISSN values are NNNN-NNNC." .
